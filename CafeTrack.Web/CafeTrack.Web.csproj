<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Fase 1: se compila con el SDK disponible en el equipo (net9.0).
         Para .NET 10 basta con cambiar este valor a net10.0. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cafetrack-fase1</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
