@page
@model CafeTrack.Web.Pages.Pagos.RegistrarModel
@{
    ViewData["Title"] = "Pago al productor";
    ViewData["Pagina"] = "pagos";
}

<header class="encabezado-pagina">
    <h1>Registrar pago al productor</h1>
    <p>
        Se paga una sola vez por venta. La cooperativa le vendió el café a un comprador;
        aquí se le liquida al productor que lo cosechó, al precio que se le pactó a él,
        menos lo que se le haya adelantado.
    </p>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Exito))
{
    @await Html.PartialAsync("_Toast", new Dialogo
    {
        Tipo = "exito",
        Mensaje = Model.Exito,
        Detalle = Model.ExitoDetalle
    })
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorBase))
{
    @await Html.PartialAsync("_Dialogo", new Dialogo
    {
        Titulo = "La base rechazó el pago",
        Mensaje = Model.ErrorBase,
        Detalle = "No se registró el pago: revise el monto y las deducciones."
    })
}

@if (Model.Ventas.Count == 0)
{
    <div class="tabla-envoltura">
        <p class="sin-datos">
            No hay ventas pendientes de pago. Aparecen aquí apenas el gerente registra
            una venta.
        </p>
    </div>
}
else
{
    <div class="rejilla">
        <article class="tarjeta">
            <h2 class="tarjeta-titulo">Esperando pago</h2>
            <p class="cifra">@Model.Ventas.Count</p>
            <p class="tarjeta-nota">
                @(Model.Ventas.Count == 1 ? "venta sin liquidar" : "ventas sin liquidar")
            </p>
        </article>
        <article class="tarjeta">
            <h2 class="tarjeta-titulo">Valor vendido</h2>
            <p class="cifra">@Formato.Moneda(Model.TotalPendiente)</p>
            <p class="tarjeta-nota">lo que pagaron los compradores</p>
        </article>
        <article class="tarjeta">
            <h2 class="tarjeta-titulo">Más antigua</h2>
            <p class="cifra">@Model.DiasEsperando<span class="cifra-unidad">días</span></p>
            <p class="tarjeta-nota">desde la venta sin pagar más vieja</p>
        </article>
    </div>

    <form method="post" class="panel formulario" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="aviso error"></div>

        <div class="campo ancho">
            <label asp-for="Datos.IdVenta">Venta que se paga</label>
            <select asp-for="Datos.IdVenta" id="venta">
                <option value="">Seleccione una venta…</option>
                @foreach (var v in Model.Ventas)
                {
                    <option value="@v.IdVenta"
                            data-peso="@Formato.Invariante(v.PesoVendido)"
                            data-precio="@Formato.Invariante(v.PrecioVenta)"
                            data-total="@Formato.Invariante(v.TotalVenta)"
                            data-lote="@v.CodigoLote"
                            data-productor="@v.Productor"
                            data-comprador="@v.Comprador"
                            data-fecha="@Formato.Fecha(v.FechaVenta)"
                            data-forma="@Formato.Enum(v.FormaPago)"
                            data-bodega="@v.Bodega">
                        Venta @v.IdVenta · @v.CodigoLote · @v.Productor —
                        @Formato.Quintales(v.PesoVendido) qq
                    </option>
                }
            </select>
            <span asp-validation-for="Datos.IdVenta" class="error-campo"></span>
        </div>

        @* Ficha de la venta: de dónde viene el dinero que se está repartiendo. *@
        <div class="campo ancho">
            <div class="ficha-lote" id="ficha" hidden>
                <div class="ficha-dato">
                    <span class="ficha-titulo">Lote</span>
                    <span class="ficha-valor mono" id="ficha-lote">—</span>
                </div>
                <div class="ficha-dato">
                    <span class="ficha-titulo">Productor</span>
                    <span class="ficha-valor" id="ficha-productor">—</span>
                </div>
                <div class="ficha-dato">
                    <span class="ficha-titulo">Comprador</span>
                    <span class="ficha-valor" id="ficha-comprador">—</span>
                </div>
                <div class="ficha-dato">
                    <span class="ficha-titulo">Vendido</span>
                    <span class="ficha-valor" id="ficha-venta">—</span>
                </div>
                <div class="ficha-dato">
                    <span class="ficha-titulo">Forma de pago</span>
                    <span class="ficha-valor" id="ficha-forma">—</span>
                </div>
            </div>
        </div>

        <div class="campo">
            <label asp-for="Datos.Precio">Precio pagado al productor (Q/qq)</label>
            <input asp-for="Datos.Precio" id="precio" type="number" step="0.01" min="0.01"
                   inputmode="decimal" />
            <span class="ayuda" id="ayuda-precio">Lo acordado con el productor.</span>
            <span asp-validation-for="Datos.Precio" class="error-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="Datos.Deducciones">Deducciones (Q)</label>
            <input asp-for="Datos.Deducciones" id="deducciones" type="number" step="0.01" min="0"
                   inputmode="decimal" />
            <span class="ayuda" id="ayuda-deducciones">
                Insumos, anticipos, transporte. No pueden superar el monto.
            </span>
            <span asp-validation-for="Datos.Deducciones" class="error-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="Datos.Metodo">Método de pago</label>
            <select asp-for="Datos.Metodo" id="metodo">
                <option value="">Seleccione…</option>
                @foreach (var m in CafeTrack.Web.Pages.Pagos.RegistrarModel.Metodos)
                {
                    <option value="@m">@m</option>
                }
            </select>
            <span class="ayuda" id="ayuda-metodo">Cómo se le entrega el dinero.</span>
            <span asp-validation-for="Datos.Metodo" class="error-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="Datos.Comprobante">Comprobante</label>
            <input asp-for="Datos.Comprobante" maxlength="50" autocomplete="off"
                   placeholder="TRF-2026-0001" />
            <span class="ayuda">Número de transferencia, cheque o recibo.</span>
            <span asp-validation-for="Datos.Comprobante" class="error-campo"></span>
        </div>

        @* La liquidación, línea por línea, como quedará guardada. *@
        <div class="campo ancho">
            <div class="cuenta-venta" id="cuenta">
                <div class="cuenta-fila">
                    <span class="cuenta-etiqueta">Monto del pago</span>
                    <span class="cuenta-cifra" id="cuenta-monto">Q 0.00</span>
                </div>
                <div class="cuenta-fila">
                    <span class="cuenta-etiqueta">Deducciones</span>
                    <span class="cuenta-cifra" id="cuenta-deducciones">− Q 0.00</span>
                </div>
                <div class="cuenta-linea">
                    <span class="cuenta-etiqueta">Recibe el productor</span>
                    <span class="cuenta-total" id="cuenta-neto">Q 0.00</span>
                </div>
                <p class="cuenta-detalle" id="cuenta-detalle">
                    Elija la venta y escriba el precio acordado.
                </p>
            </div>
        </div>

        <div class="acciones-formulario">
            <button class="boton" type="submit">Registrar pago</button>
            <a class="boton secundario" asp-page="/Pagos/Index">Ver pendientes y pagos</a>
        </div>
    </form>

    <p class="resumen-filtro">
        Cada venta se paga una sola vez y las deducciones nunca pueden superar el monto.
        Al guardar, la venta queda marcada como <em>Pagado</em>.
    </p>
}

@section Scripts {
    <script src="~/js/pago.js" asp-append-version="true" defer></script>
}
