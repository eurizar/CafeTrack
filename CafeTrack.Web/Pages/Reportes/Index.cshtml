@page
@using CafeTrack.Web.Helpers
@model CafeTrack.Web.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes";
    ViewData["Pagina"] = "reportes";
}

<header class="encabezado-pagina">
    <h1>Reportes</h1>
    <p>
        Once reportes de la cooperativa, listos para consultar en pantalla o
        descargar en Excel.
    </p>
</header>

<div class="rejilla rejilla-reportes">
    @foreach (var r in Model.Reportes)
    {
        <a class="tarjeta reporte" asp-page="/Reportes/Ver" asp-route-clave="@r.Clave">
            <span class="reporte-icono">
                @if (r.Icono.StartsWith("planta"))
                {
                    @* Ilustracion propia de la cooperativa en vez de un icono generico. *@
                    @await Html.PartialAsync("_Planta", r.Icono["planta".Length..] + ":20")
                }
                else
                {
                    @await Html.PartialAsync("_Icono", r.Icono + ":20")
                }
            </span>
            <h2>@r.Titulo</h2>
            <p class="reporte-pregunta">@r.Pregunta</p>
        </a>
    }
</div>
