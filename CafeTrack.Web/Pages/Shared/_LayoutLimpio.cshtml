@*
    Plantilla sin barra lateral: se usa en las pantallas que no requieren
    sesion iniciada (ingreso y cierre de sesion).

    El fondo es una foto del cafetal con desenfoque suave. Mientras la foto
    carga se ve una miniatura borrosa incrustada aqui mismo, de modo que no
    hay salto ni pantalla en blanco.
*@
<!DOCTYPE html>
<html lang="es-GT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CaféTrack</title>
    <link rel="icon" type="image/svg+xml" href="~/img/grano.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Mono:wght@400;600&family=Source+Sans+3:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/cafetrack.css" asp-append-version="true" />
    <style>
        /* Miniatura de 24 px incrustada: se pinta de inmediato y sostiene el
           color mientras llega la foto completa. */
        .fondo { background-image: url("data:image/jpeg;base64,"); }
    </style>
</head>
<body class="sin-barra">
    <div class="fondo" aria-hidden="true">
        <img class="fondo-foto"
             src="~/img/fondo-cafetal.jpg"
             @* srcset no pasa por el tag helper: las rutas van absolutas. *@
             srcset="/img/fondo-cafetal-chico.jpg 1100w, /img/fondo-cafetal.jpg 1920w"
             sizes="100vw" alt="" decoding="async" fetchpriority="high" />
    </div>

    <main class="contenido-limpio">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
