@using CafeTrack.Web.Helpers
@inject IUsuarioActual Sesion
@{
    // Cada pagina define ViewData["Pagina"] para marcar su entrada en la barra lateral.
    var pagina = ViewData["Pagina"] as string ?? string.Empty;
    string Activo(string nombre) => pagina == nombre ? "activo" : string.Empty;

    // El menu solo muestra lo que el rol puede abrir; la base lo vuelve a verificar.
    var puedeAcopiar = User.IsInRole("admin") || User.IsInRole("acopiador");
    var puedeVender = User.IsInRole("admin") || User.IsInRole("gerente");
    var puedeAuditar = User.IsInRole("admin") || User.IsInRole("auditor");
    var esAdmin = User.IsInRole("admin");
    var puedeCatar = User.IsInRole("admin") || User.IsInRole("catador");
    var registra = puedeAcopiar || puedeVender || puedeCatar;
}
<!DOCTYPE html>
<html lang="es-GT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CaféTrack</title>
    <link rel="icon" type="image/svg+xml" href="~/img/grano.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Mono:wght@400;600&family=Source+Sans+3:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/cafetrack.css" asp-append-version="true" />
    <script>
        // Restaura el estado de la barra antes de pintar, para que no parpadee al navegar.
        try {
            if (localStorage.getItem('cafetrack-barra') === 'compacta') {
                document.documentElement.classList.add('barra-compacta');
            }
        } catch (e) { /* almacenamiento no disponible: la barra queda expandida */ }
    </script>
</head>
<body>
    <div class="armazon">
        <nav class="barra" aria-label="Navegación principal">
            <div class="barra-cabecera">
                <a class="marca" asp-page="/Index" title="CaféTrack">
                    @await Html.PartialAsync("_Planta", "1:26")
                    <span class="marca-texto">CaféTrack</span>
                </a>
                <button type="button" class="barra-boton" id="barra-boton"
                        aria-expanded="true" aria-controls="menu-principal" title="Contraer la barra">
                    @await Html.PartialAsync("_Icono", "contraer")
                    <span class="oculto-visual">Contraer la barra</span>
                </button>
            </div>

            <ul class="menu" id="menu-principal">
                <li>
                    <a class="@Activo("panel")" asp-page="/Index" title="Panel">
                        @await Html.PartialAsync("_Icono", "panel") <span>Panel</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("catalogo")" asp-page="/Catalogo" title="Café y proceso">
                        @await Html.PartialAsync("_Icono", "taza") <span>Café y proceso</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("productores")" asp-page="/Productores" title="Productores">
                        @await Html.PartialAsync("_Icono", "productores") <span>Productores</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("parcelas")" asp-page="/Parcelas" title="Parcelas">
                        @await Html.PartialAsync("_Icono", "hoja") <span>Parcelas</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("lotes")" asp-page="/Lotes/Index" title="Lotes">
                        @await Html.PartialAsync("_Icono", "costal") <span>Lotes</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("existencias")" asp-page="/Existencias" title="Existencias">
                        @await Html.PartialAsync("_Icono", "bascula") <span>Existencias</span>
                    </a>
                </li>
                <li>
                    <a class="@Activo("reportes")" asp-page="/Reportes/Index" title="Reportes">
                        @await Html.PartialAsync("_Icono", "reportes") <span>Reportes</span>
                    </a>
                </li>
            </ul>

            @if (registra)
            {
                <p class="menu-titulo">Registro</p>
                <ul class="menu">
                    @if (puedeAcopiar)
                    {
                        <li>
                            <a class="@Activo("acopios")" asp-page="/Acopios/Registrar" title="Registrar acopio">
                                @await Html.PartialAsync("_Icono", "camion") <span>Acopio</span>
                            </a>
                        </li>
                        <li>
                            <a class="@Activo("procesos")" asp-page="/Procesos/Registrar" title="Etapa del beneficiado">
                                @await Html.PartialAsync("_Icono", "beneficio") <span>Beneficiado</span>
                            </a>
                        </li>
                    }
                    @if (puedeCatar)
                    {
                        <li>
                            <a class="@Activo("calidad")" asp-page="/Calidad/Registrar" title="Registrar catación">
                                @await Html.PartialAsync("_Icono", "taza") <span>Catación</span>
                            </a>
                        </li>
                    }
                    @if (puedeAcopiar)
                    {
                        <li>
                            <a class="@Activo("traslado")" asp-page="/Bodegas/Trasladar" title="Traslado entre bodegas">
                                @await Html.PartialAsync("_Icono", "traslado") <span>Traslado</span>
                            </a>
                        </li>
                        <li>
                            <a class="@Activo("bodega")" asp-page="/Bodegas/Ingresar" title="Ingreso a bodega">
                                @await Html.PartialAsync("_Icono", "bodega") <span>Ingreso a bodega</span>
                            </a>
                        </li>
                    }
                    @if (puedeVender)
                    {
                        <li>
                            <a class="@Activo("ventas")" asp-page="/Ventas/Registrar" title="Registrar venta">
                                @await Html.PartialAsync("_Icono", "quetzal") <span>Venta</span>
                            </a>
                        </li>
                        <li>
                            <a class="@Activo("compradores")" asp-page="/Compradores/Index" title="Compradores">
                                @await Html.PartialAsync("_Icono", "productores") <span>Compradores</span>
                            </a>
                        </li>
                        <li>
                            <a class="@Activo("pagos")" asp-page="/Pagos/Index" title="Pagos al productor">
                                @await Html.PartialAsync("_Icono", "pago") <span>Pagos al productor</span>
                            </a>
                        </li>
                    }
                </ul>
            }

            @if (puedeAuditar)
            {
                <p class="menu-titulo">Auditoría</p>
                <ul class="menu">
                    <li>
                        <a class="@Activo("bitacora")" asp-page="/Bitacora/Index" title="Bitácora">
                            @await Html.PartialAsync("_Icono", "certificado") <span>Bitácora</span>
                        </a>
                    </li>
                    <li>
                        <a class="@Activo("pruebas")" asp-page="/Pruebas/Errores" title="Errores de la base">
                            @await Html.PartialAsync("_Icono", "rechazado") <span>Errores de la base</span>
                        </a>
                    </li>
                    @if (esAdmin)
                    {
                        <li>
                            <a class="@Activo("usuarios")" asp-page="/Usuarios/Index" title="Usuarios y permisos">
                                @await Html.PartialAsync("_Icono", "productores") <span>Usuarios</span>
                            </a>
                        </li>
                    }
                </ul>
            }

            <div class="barra-sesion">
                <div class="sesion-datos">
                    <span class="sesion-icono">@await Html.PartialAsync("_Icono", "productores:16")</span>
                    <div>
                        <strong>@Sesion.NombreCompleto</strong>
                        <span class="sesion-rol">@Sesion.Rol</span>
                    </div>
                </div>
                <a class="sesion-clave" asp-page="/Cuenta/CambiarClave"
                   title="Cambiar mi contraseña">Cambiar clave</a>
                <form method="post" asp-page="/Cuenta/Salir">
                    <button class="boton secundario boton-salir" type="submit"
                            title="Cerrar sesión">Salir</button>
                </form>
            </div>

            <div class="barra-pie">
                Trazabilidad y control de existencias<br />
                Cooperativa cafetalera · Alta Verapaz
            </div>
        </nav>

        <main class="contenido">
            @RenderBody()

            <footer class="pie-pagina">
                <div class="pie-columna">
                    <p class="pie-marca">CaféTrack</p>
                    <p>Trazabilidad y control de existencias de café</p>
                </div>

                <div class="pie-columna">
                    <p class="pie-titulo">Contacto</p>
                    <p><a href="mailto:contacto@cafetrack.gt">contacto@cafetrack.gt</a></p>
                    <p>Cobán, Alta Verapaz, Guatemala</p>
                </div>

                <div class="pie-columna">
                    <p class="pie-titulo">Sistema</p>
                    <p>Versión @(typeof(Program).Assembly.GetName().Version?.ToString(3) ?? "1.0.0")</p>
                    <p><a asp-page="/Catalogo">Café y proceso</a></p>
                </div>

                <p class="pie-derechos">
                    © @DateTime.Now.Year CaféTrack. Todos los derechos reservados.
                </p>
            </footer>
        </main>
    </div>

    @* Ventana de confirmacion compartida; la usa cualquier formulario con
       el atributo data-confirmar. *@
    <dialog class="dialogo dialogo-error" id="dialogo-confirmar"
            aria-labelledby="confirmar-titulo">
        <div class="dialogo-cuerpo">
            <span class="dialogo-icono">@await Html.PartialAsync("_Icono", "certificado:28")</span>
            <h2 id="confirmar-titulo">¿Confirma la acción?</h2>
            <p class="dialogo-mensaje" id="confirmar-mensaje"></p>
        </div>
        <div class="dialogo-acciones dialogo-acciones-dobles">
            <button class="boton secundario" type="button" id="confirmar-no">Cancelar</button>
            <button class="boton" type="button" id="confirmar-si">Continuar</button>
        </div>
    </dialog>

    <script src="~/js/barra.js" asp-append-version="true" defer></script>
    <script src="~/js/confirmar.js" asp-append-version="true" defer></script>
    <script src="~/js/dialogo.js" asp-append-version="true" defer></script>
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
